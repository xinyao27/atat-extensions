{
  "name": "atat-extensions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The official directory of AtAt plugins.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.mjs",
    "package": "node scripts/package.mjs",
    "verify": "pnpm validate && pnpm typecheck && node scripts/verify-build.mjs"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "react": "19.2.8",
    "rolldown": "1.2.3",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.21.0"
}
