{
  "identifier": "markdown-tools",
  "name": {
    "en": "Markdown Tools",
    "zh-hans": "Markdown 工具"
  },
  "description": {
    "en": "Turns what you select into Markdown lists, code, or quotes.",
    "zh-hans": "把选中的文字变成 Markdown 列表、代码或引用。"
  },
  "version": "1.0.0",
  "apiVersion": 1,
  "minimumAppVersion": "1.2.0",
  "author": "@@",
  "actions": [
    {
      "identifier": "bulletList",
      "title": {
        "en": "Bullet list",
        "zh-hans": "项目符号列表"
      },
      "icon": "text",
      "surfaces": [
        "selectionBar",
        "clipboardHistory",
        "captureQuickAccess"
      ],
      "requirements": {
        "contentTypes": [
          "text"
        ]
      },
      "after": "paste"
    },
    {
      "identifier": "numberedList",
      "title": {
        "en": "Numbered list",
        "zh-hans": "编号列表"
      },
      "icon": "document",
      "surfaces": [
        "selectionBar",
        "clipboardHistory",
        "captureQuickAccess"
      ],
      "requirements": {
        "contentTypes": [
          "text"
        ]
      },
      "after": "paste"
    },
    {
      "identifier": "code",
      "title": {
        "en": "Code",
        "zh-hans": "代码"
      },
      "icon": "code",
      "surfaces": [
        "selectionBar",
        "clipboardHistory",
        "captureQuickAccess"
      ],
      "requirements": {
        "contentTypes": [
          "text"
        ]
      },
      "after": "paste"
    },
    {
      "identifier": "blockquote",
      "title": {
        "en": "Blockquote",
        "zh-hans": "引用"
      },
      "icon": "quote",
      "surfaces": [
        "selectionBar",
        "clipboardHistory",
        "captureQuickAccess"
      ],
      "requirements": {
        "contentTypes": [
          "text"
        ]
      },
      "after": "paste"
    }
  ]
}
