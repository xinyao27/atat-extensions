{
  "identifier": "github",
  "name": {
    "en": "GitHub",
    "zh-hans": "GitHub"
  },
  "description": {
    "en": "Turns what you select or copy into a GitHub issue, or shares code as a gist.",
    "zh-hans": "把选中或复制的内容建成 GitHub issue，或把代码分享成 gist。"
  },
  "version": "1.0.0",
  "apiVersion": 1,
  "minimumAppVersion": "1.2.0",
  "author": "@@",
  "entitlements": [
    "agent",
    "network",
    "secrets"
  ],
  "networkHosts": [
    "api.github.com"
  ],
  "options": [
    {
      "identifier": "token",
      "type": "secret",
      "label": {
        "en": "Personal access token",
        "zh-hans": "个人访问令牌"
      },
      "description": {
        "en": "A fine-grained token with Issues access to your repositories. Add Gists to share code.",
        "zh-hans": "一个细粒度令牌，给你的仓库开 Issues 权限；要分享代码再加上 Gists。"
      }
    },
    {
      "identifier": "defaultRepository",
      "type": "string",
      "label": {
        "en": "Default repository",
        "zh-hans": "默认仓库"
      },
      "description": {
        "en": "Picked first when you create an issue, as owner/name.",
        "zh-hans": "建 issue 时默认选中的仓库，格式是 owner/name。"
      },
      "defaultValue": ""
    },
    {
      "identifier": "draftWithAgent",
      "type": "boolean",
      "label": {
        "en": "Draft with your agent",
        "zh-hans": "让助手起草"
      },
      "description": {
        "en": "Your agent writes the title and tidies the description; you still review both.",
        "zh-hans": "由你的助手写标题、整理描述，发出去之前你都能改。"
      },
      "defaultValue": true
    }
  ],
  "views": [
    {
      "identifier": "issue"
    },
    {
      "identifier": "gist"
    }
  ],
  "actions": [
    {
      "identifier": "createIssue",
      "title": {
        "en": "Create GitHub Issue",
        "zh-hans": "建 GitHub Issue"
      },
      "icon": "github",
      "surfaces": [
        "selectionBar",
        "clipboardHistory",
        "captureQuickAccess"
      ],
      "requirements": {
        "contentTypes": [
          "text"
        ]
      },
      "view": "issue"
    },
    {
      "identifier": "createGist",
      "title": {
        "en": "Share as Gist",
        "zh-hans": "分享成 Gist"
      },
      "icon": "source-code",
      "surfaces": [
        "selectionBar",
        "clipboardHistory"
      ],
      "requirements": {
        "contentTypes": [
          "text"
        ]
      },
      "view": "gist"
    }
  ]
}
