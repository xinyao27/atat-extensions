{
  "description": "saving into a database adds a row, with the title in the database's own title column",
  "secrets": { "token": "ntn_test" },
  "fetch": { "https://api.notion.com/v1/pages": { "json": { "url": "https://www.notion.so/Ship-the-card-row1" } } },
  "call": {
    "routine": "create",
    "args": [
      { "id": "ds-1", "kind": "dataSource", "title": "Tasks", "url": "https://www.notion.so/tasks", "titleProperty": "Task" },
      "Ship the card",
      "Dictionary card lands above translations."
    ]
  },
  "expect": {
    "result": { "url": "https://www.notion.so/Ship-the-card-row1", "title": "Ship the card" },
    "requests": [
      "POST https://api.notion.com/v1/pages",
      "\"parent\":{\"data_source_id\":\"ds-1\"}",
      "\"Task\":{\"title\":[{\"type\":\"text\",\"text\":{\"content\":\"Ship the card\"}}]}"
    ]
  }
}
