{
  "description": "a selection is appended to a page as one paragraph per line, blank lines kept",
  "secrets": {
    "token": "ntn_test"
  },
  "fetch": {
    "https://api.notion.com/v1/blocks/page-1/children": {
      "json": {
        "results": []
      }
    }
  },
  "call": {
    "routine": "append",
    "args": [
      {
        "id": "page-1",
        "kind": "page",
        "title": "Reading notes",
        "url": "https://www.notion.so/Reading-notes-page1"
      },
      "First idea\n\nSecond idea"
    ]
  },
  "expect": {
    "result": {
      "url": "https://www.notion.so/Reading-notes-page1",
      "title": "Reading notes"
    },
    "requests": [
      "PATCH https://api.notion.com/v1/blocks/page-1/children",
      "{\"type\":\"text\",\"text\":{\"content\":\"First idea\"}}",
      "{\"object\":\"block\",\"type\":\"paragraph\",\"paragraph\":{\"rich_text\":[]}}",
      "{\"type\":\"text\",\"text\":{\"content\":\"Second idea\"}}"
    ]
  }
}
