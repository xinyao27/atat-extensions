{
  "description": "the picker lists shared pages and databases by title, the trash left out",
  "secrets": {
    "token": "ntn_test"
  },
  "fetch": {
    "https://api.notion.com/v1/search": {
      "json": {
        "results": [
          {
            "object": "page",
            "id": "p1",
            "url": "https://www.notion.so/p1",
            "properties": {
              "title": {
                "type": "title",
                "title": [
                  {
                    "plain_text": "Reading notes"
                  }
                ]
              }
            }
          },
          {
            "object": "data_source",
            "id": "d1",
            "url": "https://www.notion.so/d1",
            "title": [
              {
                "plain_text": "Tasks"
              }
            ],
            "properties": {
              "Task": {
                "type": "title"
              },
              "Due": {
                "type": "date"
              }
            }
          },
          {
            "object": "page",
            "id": "p2",
            "in_trash": true,
            "url": "https://www.notion.so/p2",
            "properties": {}
          }
        ]
      }
    }
  },
  "call": {
    "routine": "search",
    "args": [
      ""
    ]
  },
  "expect": {
    "result": [
      {
        "id": "p1",
        "kind": "page",
        "title": "Reading notes"
      },
      {
        "id": "d1",
        "kind": "dataSource",
        "title": "Tasks",
        "titleProperty": "Task"
      }
    ],
    "requests": [
      "POST https://api.notion.com/v1/search",
      "\"direction\":\"descending\""
    ]
  }
}
