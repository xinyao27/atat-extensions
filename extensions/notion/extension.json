{
  "identifier": "notion",
  "name": {
    "en": "Notion",
    "zh-hans": "Notion"
  },
  "description": {
    "en": "Adds what you select or copy to a Notion page, or saves it as a new page.",
    "zh-hans": "把选中或复制的内容追加到 Notion 页面里，或存成一个新页面。"
  },
  "version": "1.0.0",
  "apiVersion": 1,
  "minimumAppVersion": "1.2.0",
  "author": "@@",
  "entitlements": [
    "agent",
    "network",
    "secrets",
    "memorySource"
  ],
  "networkHosts": [
    "api.notion.com"
  ],
  "options": [
    {
      "identifier": "token",
      "type": "secret",
      "label": {
        "en": "Integration secret",
        "zh-hans": "集成密钥"
      },
      "description": {
        "en": "From an internal integration in Notion. Share the pages you want with it.",
        "zh-hans": "在 Notion 里建一个内部集成拿到它，再把想用的页面共享给这个集成。"
      }
    },
    {
      "identifier": "suggestTitle",
      "type": "boolean",
      "label": {
        "en": "Suggest a title",
        "zh-hans": "自动拟标题"
      },
      "description": {
        "en": "Your agent names a new page from what you saved.",
        "zh-hans": "新建页面时，由你的助手根据内容拟一个标题。"
      },
      "defaultValue": true
    }
  ],
  "views": [
    {
      "identifier": "save"
    }
  ],
  "memorySources": [
    {
      "identifier": "workspace",
      "title": {
        "en": "Notion workspace",
        "zh-hans": "Notion 工作区"
      },
      "icon": "notion01",
      "scope": "global"
    }
  ],
  "actions": [
    {
      "identifier": "saveToNotion",
      "title": {
        "en": "Save to Notion",
        "zh-hans": "存到 Notion"
      },
      "icon": "notion01",
      "surfaces": [
        "selectionBar",
        "clipboardHistory",
        "captureQuickAccess"
      ],
      "requirements": {
        "contentTypes": [
          "text"
        ]
      },
      "view": "save"
    }
  ]
}
