{
  "description": "macOS translation answers through the host, with no network involved",
  "locale": "en",
  "options": { "useSystem": true },
  "translation": "你好，世界",
  "call": {
    "routine": "translate",
    "args": ["system", "Hello world", "zh-Hans"]
  },
  "expect": {
    "result": {
      "source": "Hello world",
      "translation": "你好，世界",
      "language": "zh-Hans",
      "instruction": null
    }
  }
}
