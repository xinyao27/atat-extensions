      "type": "choice",
      "label": {
        "en": "Second language",
        "zh-hans": "第二语言"
      },
      "description": {
        "en": "When Automatic sees Chinese script and your primary language is Chinese, it uses this language.",
        "zh-hans": "「自动」在主要语言为中文且原文含中文文字时使用这种语言。"
      },
