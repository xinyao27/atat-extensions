{
  "identifier": "translate",
  "name": {
    "en": "Translate",
    "zh-hans": "翻译"
  },
  "description": {
    "en": "Translates what you select — or the text in a screenshot — right next to it.",
    "zh-hans": "把选中的文字或截图里的文字就地翻译，译文就在旁边。"
  },
  "version": "1.1.0",
  "apiVersion": 1,
  "minimumAppVersion": "1.2.0",
  "author": "@@",
  "entitlements": [
    "agent",
    "network",
    "secrets",
    "translation"
  ],
  "networkHosts": [
    "translate.googleapis.com",
    "api.cognitive.microsofttranslator.com",
    "api-free.deepl.com",
    "api.deepl.com"
  ],
  "options": [
    {
      "identifier": "primaryLanguage",
      "type": "choice",
      "label": {
        "en": "Primary language",
        "zh-hans": "主要语言"
      },
      "description": {
        "en": "The language you usually want translations in; Automatic follows the language AtAt uses.",
        "zh-hans": "你平常想译成的语言。选「自动」时跟随 AtAt 的界面语言。"
      },
      "defaultValue": "auto",
      "values": [
        {
          "value": "auto",
          "title": {
            "en": "Automatic",
            "zh-hans": "自动"
          }
