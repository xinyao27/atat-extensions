    },
    {
      "identifier": "useAgent",
      "type": "boolean",
      "label": {
        "en": "Your agent",
        "zh-hans": "你的助手"
      },
      "description": {
        "en": "Translate with the assistant you already set up.",
        "zh-hans": "用你已经配置好的助手翻译。"
      },
      "icon": "brain03",
      "group": "agent",
      "defaultValue": true
    },
    {
      "identifier": "useSystem",
      "type": "boolean",
      "label": {
        "en": "macOS translation",
        "zh-hans": "macOS 自带翻译"
      },
      "description": {
        "en": "Translate on this Mac, once the language is downloaded in System Settings.",
        "zh-hans": "在这台 Mac 上翻译，先在系统设置里下载语言。"
      },
      "icon": "service-system.png",
      "group": "system",
      "defaultValue": false,
      "systemSettingsLink": {
        "title": {
          "en": "Download languages…",
          "zh-hans": "下载语言…"
        },
        "pane": "com.apple.Localization-Settings.extension"
      }
    },
    {
      "identifier": "useGoogle",
      "type": "boolean",
      "label": {
        "en": "Google Translate",
        "zh-hans": "Google 翻译"
      },
      "description": {
        "en": "No account and no key needed.",
        "zh-hans": "不用账号，也不用填密钥。"
      },
      "icon": "service-google.png",
      "group": "google",
      "defaultValue": false
    },
    {
      "identifier": "useMicrosoft",
      "type": "boolean",
      "label": {
        "en": "Microsoft Translator",
        "zh-hans": "微软翻译"
      },
      "description": {
        "en": "Needs a key from your Microsoft Translator resource in Azure.",
        "zh-hans": "需要 Azure 微软翻译资源里的密钥。"
      },
      "icon": "service-microsoft.png",
      "group": "microsoft",
      "defaultValue": false
    },
    {
      "identifier": "useDeepL",
      "type": "boolean",
      "label": {
        "en": "DeepL",
        "zh-hans": "DeepL"
      },
      "description": {
        "en": "Needs a key from your DeepL account.",
        "zh-hans": "需要 DeepL 账号里的密钥。"
      },
      "icon": "service-deepl.png",
      "group": "deepl",
      "defaultValue": false
    },
    {
      "identifier": "microsoftKey",
      "type": "secret",
      "label": {
        "en": "Microsoft Translator key",
        "zh-hans": "微软翻译密钥"
      },
      "description": {
        "en": "The key from your Microsoft Translator resource in Azure.",
        "zh-hans": "Azure 微软翻译资源里的密钥。"
      },
      "visibleWhen": {
        "option": "useMicrosoft",
        "equals": "true"
      },
      "group": "microsoft"
    },
    {
      "identifier": "microsoftRegion",
      "type": "string",
      "label": {
        "en": "Microsoft Translator region",
        "zh-hans": "微软翻译区域"
      },
      "description": {
        "en": "The region your key belongs to, if Azure gave you one.",
        "zh-hans": "密钥所在的区域，Azure 给了就填。"
      },
      "defaultValue": "",
      "visibleWhen": {
        "option": "useMicrosoft",
        "equals": "true"
      },
      "group": "microsoft"
    },
    {
      "identifier": "deeplKey",
      "type": "secret",
      "label": {
        "en": "DeepL key",
        "zh-hans": "DeepL 密钥"
      },
      "description": {
        "en": "The key from your DeepL account.",
        "zh-hans": "DeepL 账号里的密钥。"
      },
      "visibleWhen": {
        "option": "useDeepL",
        "equals": "true"
      },
      "group": "deepl"
    }
  ],
  "views": [
    {
      "identifier": "translation"
    }
  ],
  "actions": [
    {
      "identifier": "translate",
      "title": {
        "en": "Translate",
        "zh-hans": "翻译"
      },
      "icon": "translate",
      "surfaces": [
        "selectionBar",
        "clipboardHistory",
        "captureQuickAccess"
      ],
      "requirements": {
        "contentTypes": [
          "text",
          "image"
        ]
      },
      "view": "translation"
    }
  ]
}
