<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The indexer: iCloud placeholders down, then qmd update, then qmd embed.

  A template — setup.sh substitutes the __PLACEHOLDERS__, including one WatchPaths entry per
  granted folder, and installs the result into ~/Library/LaunchAgents.

  Three triggers, because one is not enough. WatchPaths catches a file arriving from a phone
  within seconds. StartInterval catches everything WatchPaths cannot see: a change deep inside a
  subfolder, and any moment the Mac was asleep. ThrottleInterval keeps a burst of arrivals from
  becoming a burst of embeddings.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.atat.memory.indexer</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__SYNC_SCRIPT__</string>
		<string>__MEMORY_DIRECTORIES__</string>
	</array>

	<!-- setup.sh runs one sync itself, so loading this does not need to be a fourth trigger. -->
	<key>RunAtLoad</key>
	<false/>

	<key>WatchPaths</key>
	<array>
		<string>__WATCH_PATHS__</string>
	</array>

	<key>StartInterval</key>
	<integer>600</integer>
	<key>ThrottleInterval</key>
	<integer>60</integer>

	<!-- Indexing is background work, and it shares a laptop with whatever the user is doing. -->
	<key>LowPriorityIO</key>
	<true/>
	<key>Nice</key>
	<integer>5</integer>
	<key>ProcessType</key>
	<string>Background</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>__LAUNCH_PATH__</string>
	</dict>

	<key>StandardOutPath</key>
	<string>__LOG_DIRECTORY__/atat-memory-indexer.log</string>
	<key>StandardErrorPath</key>
	<string>__LOG_DIRECTORY__/atat-memory-indexer.log</string>
</dict>
</plist>
