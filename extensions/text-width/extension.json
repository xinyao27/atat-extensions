{
  "identifier": "text-width",
  "name": {
    "en": "Text Width",
    "zh-hans": "全半角"
  },
  "description": {
    "en": "Converts full-width and half-width characters — letters, punctuation, katakana — either way.",
    "zh-hans": "在全角和半角之间转换：字母、标点、日文假名都认。"
  },
  "version": "1.0.0",
  "apiVersion": 1,
  "minimumAppVersion": "1.2.0",
  "author": "@@",
  "actions": [
    {
      "identifier": "toHalfWidth",
      "title": {
        "en": "To half width",
        "zh-hans": "转半角"
      },
      "icon": "text",
      "surfaces": [
        "selectionBar",
        "clipboardHistory",
        "captureQuickAccess"
      ],
      "requirements": {
        "contentTypes": [
          "text"
        ],
        "regex": "[\\u3000\\u30A1-\\u30F6\\u30FC\\uFF01-\\uFF5E]"
      },
      "after": "paste"
    },
    {
      "identifier": "toFullWidth",
      "title": {
        "en": "To full width",
        "zh-hans": "转全角"
      },
      "icon": "edit",
      "surfaces": [
        "selectionBar",
        "clipboardHistory",
        "captureQuickAccess"
      ],
      "requirements": {
        "contentTypes": [
          "text"
        ],
        "regex": "[!-~\\uFF66-\\uFF9F]"
      },
      "after": "paste"
    }
  ]
}
