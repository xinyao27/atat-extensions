{
  "description": "a small limit stops the walk mid-vault and the cursor resumes it next call",
  "options": { "vault": "{folder}" },
  "files": {
    "a/one.md": "# One\n\nfirst\n",
    "a/two.md": "# Two\n\nsecond\n",
    "b/three.md": "# Three\n\nthird\n"
  },
  "call": {
    "memorySource": "vault",
    "input": { "limit": 2 }
  },
  "expect": {
    "result": {
      "items": [
        { "externalKey": "a/one.md", "title": "One" },
        { "externalKey": "a/two.md", "title": "Two" }
      ],
      "complete": false
    },
    "contains": ["nextCursor"]
  }
}
