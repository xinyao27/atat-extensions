{
  "description": "saving to today's note appends a timestamped block below what the note already holds",
  "options": { "vault": "{folder}", "inboxFolder": "Inbox", "dailyFolder": "Daily", "dailyFormat": "YYYY-MM-DD" },
  "files": { "Daily/2026-09-26.md": "# Friday\n\n- stand-up at ten\n" },
  "call": {
    "routine": "save",
    "args": ["daily", "", "Ship the dictionary card.", "2026-09-26T21:30:00"]
  },
  "expect": {
    "result": { "relativePath": "Daily/2026-09-26.md", "destination": "daily" },
    "files": [
      { "path": "Daily/2026-09-26.md", "count": 1, "contains": ["- stand-up at ten", "### 21:30", "Ship the dictionary card."] }
    ]
  }
}
