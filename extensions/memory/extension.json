{
  "identifier": "memory",
  "name": {
    "en": "Memory",
    "zh-hans": "记忆"
  },
  "description": {
    "en": "Keeps the things you tell @@ to remember, and brings them back when they fit.",
    "zh-hans": "把你让 @@ 记住的东西存成笔记，用得上的时候再拿出来。"
  },
  "version": "1.1.0",
  "apiVersion": 1,
  "minimumAppVersion": "0.10.0",
  "author": "@@",
  "entitlements": [],
  "options": [
    {
      "identifier": "memoryFolder",
      "type": "folder",
      "label": {
        "en": "Memory folder",
        "zh-hans": "记忆目录"
      },
      "description": {
        "en": "Where your notes are kept. It starts in iCloud Drive, so your phone can add to it too.",
        "zh-hans": "笔记存放的位置。默认在 iCloud Drive 里，手机也能往里存。"
      },
      "defaultPath": "shortcuts"
    }
  ],
  "hooks": [
    {
      "hook": "contextAssembled"
    }
  ],
  "actions": [
    {
      "identifier": "saveToMemory",
      "icon": "brain",
      "title": {
        "en": "Save to memory",
        "zh-hans": "存入记忆"
      },
      "surfaces": [
        "selectionBar",
        "clipboardHistory",
        "captureQuickAccess"
      ],
      "after": "none"
    }
  ],
  "views": [
    {
      "identifier": "memory"
    }
  ],
  "panels": [
    {
      "identifier": "memory",
      "view": "memory",
      "title": {
        "en": "Memory",
        "zh-hans": "记忆"
      }
    }
  ],
  "reads": [
    {
      "identifier": "claude-code",
      "paths": ["~/.claude/projects/*/memory"],
      "title": {
        "en": "What Claude Code remembers",
        "zh-hans": "Claude Code 记住的东西"
      }
    },
    {
      "identifier": "codex",
      "paths": ["~/.codex/memories"],
      "title": {
        "en": "What Codex remembers",
        "zh-hans": "Codex 记住的东西"
      }
    },
    {
      "identifier": "hermes",
      "paths": ["~/.hermes/memories", "~/.hermes/profiles/*/memories"],
      "title": {
        "en": "What Hermes remembers",
        "zh-hans": "Hermes 记住的东西"
      }
    },
    {
      "identifier": "openclaw",
      "paths": ["~/.openclaw/workspace"],
      "title": {
        "en": "What OpenClaw remembers",
        "zh-hans": "OpenClaw 记住的东西"
      }
    },
    {
      "identifier": "gemini-cli",
      "paths": ["~/.gemini/tmp/*/memory"],
      "title": {
        "en": "What Gemini CLI remembers",
        "zh-hans": "Gemini CLI 记住的东西"
      }
    },
    {
      "identifier": "qwen-code",
      "paths": ["~/.qwen/memories", "~/.qwen/projects/*/memory"],
      "title": {
        "en": "What Qwen Code remembers",
        "zh-hans": "Qwen Code 记住的东西"
      }
    },
    {
      "identifier": "trae",
      "paths": ["~/.trae/memory", "~/.trae-cn/memory"],
      "title": {
        "en": "What Trae remembers",
        "zh-hans": "Trae 记住的东西"
      }
    },
    {
      "identifier": "goose",
      "paths": ["~/.config/goose/memory"],
      "title": {
        "en": "What Goose remembers",
        "zh-hans": "Goose 记住的东西"
      }
    }
  ]
}
