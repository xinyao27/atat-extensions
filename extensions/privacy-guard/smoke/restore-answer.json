{
  "description": "puts the real name back in the answer of the turn that masked it",
  "storage": {
    "turns": {
      "t1": {
        "at": 0,
        "restore": {
          "Jane Doe": "Alice Smith"
        }
      }
    }
  },
  "call": {
    "hook": "answerAssembled",
    "input": {
      "prompt": "Who am I?",
      "responseText": "You are Jane Doe.",
      "items": [],
      "turnID": "t1"
    }
  },
  "expect": {
    "result": {
      "rewrite": {
        "responseText": "You are Alice Smith."
      }
    }
  }
}
